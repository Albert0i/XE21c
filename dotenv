# ==========================================
# ORACLE XE 21c SERVER SETTINGS
# ==========================================

# 1. DATABASE IMAGE NAME
# a) Oracle Database Express Edition Container / Docker images.
#    https://hub.docker.com/r/gvenzl/oracle-xe
# ORACLE_IMAGE_NAME=gvenzl/oracle-xe:21.3.0
# ORACLE_IMAGE_NAME=gvenzl/oracle-xe:21.3.0-full

# b) Oracle Database Free Container images.
#    https://hub.docker.com/r/gvenzl/oracle-free
ORACLE_IMAGE_NAME=gvenzl/oracle-free:23.26.1
# ORACLE_IMAGE_NAME=gvenzl/oracle-free:23.26.1-full

# c) Oracle AI Database 26ai Free Container Image
#    https://www.oracle.com/database/free/
# ORACLE_IMAGE_NAME=container-registry.oracle.com/database/free:23.26.2.0-lite
# ORACLE_IMAGE_NAME=container-registry.oracle.com/database/free:23.26.2.0

# 2. DATABASE ACCESS PASSWORD
# Set password for 'SYS' and 'SYSTEM' administrator accounts.
# Choose letters and numbers. Avoid spaces and special symbols.
ORACLE_ROOT_PASSWORD=123456
# To create a new pluggable database with the name specified.
ORACLE_DATABASE=mypdb

# 3. DOCKER CONTAINER NAME
# Identifier name for your running database service.
# Used by your Makefile to target the container during health tests.
ORACLE_CONTAINER_NAME=oracle-db

# 4. DATA STORAGE REPOSITORY
# Folder location on your hard drive to permanently save schemas.
# Keeps your data safe from erasure when containers reboot.
ORACLE_DATA_DIR=./oracle_data

# 5. APPLICATION USER
# Non-admin account for your apps to connect safely.
# Change these values to secure credentials.
ORACLE_HOST=localhost
ORACLE_PORT=1521

ORACLE_APP_USER=albertoi
ORACLE_APP_USER_PASSWORD=my_secure_password
